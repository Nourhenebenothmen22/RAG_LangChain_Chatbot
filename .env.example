# ==============================================================================
# Central Configuration for Database-Driven Hybrid RAG System
# ==============================================================================

# Data & Database Configuration
DATA_DIR=data
DATABASE_URL=sqlite:///data/records.sqlite3
CHROMA_DIR=chroma_db
BM25_INDEX_PATH=chroma_db/bm25_index.pkl
METRICS_DB_PATH=chroma_db/metrics.sqlite3
COLLECTION_NAME=rag_documents

# Chunking & Document Processing
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Dense Embeddings (Local HuggingFace model)
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
EMBEDDING_DEVICE=cpu
NORMALIZE_EMBEDDINGS=true

# Lexical BM25 Search Parameters
BM25_K1=1.5
BM25_B=0.75

# Retrieval & Reciprocal Rank Fusion (RRF)
DENSE_TOP_K=10
BM25_TOP_K=10
RRF_K=60
FUSED_TOP_K=10

# Cross-Encoder Reranking (Local Cross-Encoder model)
RERANKER_MODEL_NAME=cross-encoder/ms-marco-TinyBERT-L-2-v2
RERANKER_DEVICE=cpu
RERANKER_TOP_K=5
RERANKER_BATCH_SIZE=16
# MIN_RELEVANCE_SCORE=-12.0

# LLM & Generation Provider ("openai", "local", "mock")
LLM_PROVIDER=openai
LLM_MODEL_NAME=gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key_here
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=800

# Security & Prompt Injection Defense
ENABLE_PROMPT_INJECTION_DETECTION=true
MAX_QUERY_LENGTH=2000

# LangSmith Observability & Tracing V2
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=claimeye-rag
